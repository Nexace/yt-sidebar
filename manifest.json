{
  "manifest_version": 3,
  "name": "YT Sidebar",
  "version": "0.1.0",
  "description": "YouTube and YouTube Music in a persistent side panel.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "offscreen", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://*.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Open YT Sidebar",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Y" } }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["frame.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["quality.js"],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
