{
  "manifest_version": 3,
  "name": "YT Sidebar",
  "version": "0.1.0",
  "description": "YouTube and YouTube Music in a persistent side panel.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://*.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open YT Sidebar" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Y" } }
  },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*", "https://m.youtube.com/*"],
    "js": ["frame.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }]
}
